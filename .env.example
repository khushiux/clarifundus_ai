# RetinaTrust Environment Configuration Example
# Copy this file to .env for local environment overrides

# Device selection: 'cuda', 'cpu', or 'auto'
RETINATRUST_DEVICE=auto

# Server configuration
RETINATRUST_API_HOST=127.0.0.1
RETINATRUST_API_PORT=8000
RETINATRUST_LOG_LEVEL=INFO

# Model paths override (relative to project root or absolute)
# RETINATRUST_MODEL_PATH=artifacts/models/resnet18_best.pt
# RETINATRUST_CONFIG_PATH=configs/default.yaml
